{
  "name": "agentic-os",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w agentic-os-desktop",
    "build": "npm run build -w agentic-os-desktop",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "brain": "node packages/brain-sync/src/cli.ts",
    "test:e2e": "npm run test:e2e -w agentic-os-desktop"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
